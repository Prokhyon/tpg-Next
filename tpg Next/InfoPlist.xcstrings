    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Standort wird verwendet, um Haltestellen in der Nähe zu finden und Ihre Position auf einer Karte anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to find nearby stops and show your position on a map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to find nearby stops and show your position on a map."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La localisation sert à trouver les arrêts à proximité et à afficher votre position sur une carte."
          }
        }
      }
    },
