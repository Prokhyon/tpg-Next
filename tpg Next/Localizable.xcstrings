          "stringUnit" : {
            "state" : "translated",
            "value" : "Your favourites come from iPhone: edit them on iPhone and the watch follows."
          }
        }
      }
    },
    "Vos favoris, lieux, itinéraires enregistrés et trajets réguliers se retrouvent sur tous vos appareils." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Favoriten, Orte, gespeicherten Verbindungen und regelmässigen Fahrten sind auf allen Ihren Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your favorites, places, saved routes and regular trips are on all your devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your favourites, places, saved routes and regular trips are on all your devices."
          }
        }
      }
    },
    "Vos favoris, lieux, itinéraires enregistrés et trajets réguliers se retrouvent sur tous vos appareils. Désactivée, ils restent sur cet appareil ; ce qui est déjà dans iCloud n'est pas effacé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Favoriten, Orte, gespeicherten Verbindungen und regelmässigen Fahrten sind auf allen Ihren Geräten. Ist sie aus, bleiben sie auf diesem Gerät; was bereits in iCloud ist, wird nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your favorites, places, saved routes and regular trips are on all your devices. When off, they stay on this device; what’s already in iCloud isn’t deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your favourites, places, saved routes and regular trips are on all your devices. When off, they stay on this device; what’s already in iCloud isn’t deleted."
          }
        }
      }
    },
    "Vos rappels" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Erinnerungen"
          }
        },
        "en" : {
          "stringUnit" : {
