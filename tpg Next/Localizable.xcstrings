    "Appuyez longuement sur le départ" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Abfahrt gedrückt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long press the departure"
          }
        },
        "en-GB" : {
          "stringUnit" : {
