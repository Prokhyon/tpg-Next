            "value" : "The tram is arriving at Plainpalais, platform C."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tram is arriving at Plainpalais, platform C."
          }
        }
      }
    },
    "Le tri par défaut (horaire ou ligne), l'heure affichée par défaut (temps restant ou heure), et le format du retard : « 12:31 (+3') » ou l'heure réelle seule, « 12:34 »." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standardsortierung (Zeit oder Linie), die Standardanzeige der Zeit (verbleibende Zeit oder Uhrzeit) und das Format der Verspätung: „12:31 (+3')“ oder nur die tatsächliche Zeit, „12:34“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default sorting (time or line), the default time display (time left or clock time), and the delay format: “12:31 (+3')” or just the actual time, “12:34”."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default sorting (time or line), the default time display (time left or clock time), and the delay format: ‘12:31 (+3')’ or just the actual time, ‘12:34’."
          }
        }
      }
    },
    "Le week-end" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Wochenende"
          }
        },
        "en" : {
