            "state" : "translated",
            "value" : "Live tracking"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live tracking"
          }
        }
      }
    },
    "Le suivi en direct a besoin de votre position pour rester à jour, app fermée.\nAutorisez-la dans les réglages du téléphone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Live-Verfolgung braucht Ihren Standort, um bei geschlossener App aktuell zu bleiben.\nErlauben Sie ihn in den Einstellungen des Telefons"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live tracking needs your location to stay up to date while the app is closed.\nAllow it in your phone’s Settings"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live tracking needs your location to stay up to date while the app is closed.\nAllow it in your phone’s Settings"
          }
        }
      }
    },
    "Le suivi en direct a besoin de votre position. Autorisez-la, puis relancez le suivi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Live-Verfolgung braucht Ihren Standort. Erlauben Sie ihn und starten Sie die Verfolgung erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live tracking needs your location. Allow it, then start tracking again."
          }
