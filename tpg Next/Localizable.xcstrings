            "value" : "This device"
          }
        }
      }
    },
    "Cet appareil ne prévient pas : les rappels, alertes et activités en direct arrivent sur vos autres appareils. Pour changer, allez dans Paramètres." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät benachrichtigt nicht: Erinnerungen, Hinweise und Live-Aktivitäten kommen auf Ihren anderen Geräten an. Ändern Sie das in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device doesn’t notify you: reminders, alerts and Live Activities arrive on your other devices. To change this, go to Settings."
