    "Départs, itinéraires et trajets en temps réel, partout en Suisse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abfahrten, Verbindungen und Fahrten in Echtzeit, in der ganzen Schweiz."
          }
        },
        "en" : {
          "stringUnit" : {
