    "Ce trajet passe par un bus à la demande, sans horaire fixe : pas de rappel ni de suivi en direct. Pensez à le réserver." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fahrt nutzt einen Rufbus ohne festen Fahrplan: keine Erinnerung und keine Live-Verfolgung. Denken Sie an die Reservation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This trip uses an on-demand bus with no fixed timetable: no reminder or live tracking. Remember to book it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This trip uses an on-demand bus with no fixed timetable: no reminder or live tracking. Remember to book it."
