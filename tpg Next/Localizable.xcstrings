            "value" : "An experience tailored to larger screens"
          }
        }
      }
    },
    "Une frise simplifiée du trajet s'affiche à présent, avec lignes, changements, marches et attentes, dans les résultats et les itinéraires enregistrés" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
