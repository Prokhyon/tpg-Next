    "Courses supprimées, arrêts non desservis et parcours modifiés sont signalés, avec l'arrêt desservi le plus proche" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfallende Kurse, nicht bediente Haltestellen und geänderte Verläufe werden angezeigt, mit der nächstgelegenen bedienten Haltestelle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canceled services, skipped stops and changed routes are flagged, with the nearest stop still served"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelled services, skipped stops and changed routes are flagged, with the nearest stop still served"
          }
        }
