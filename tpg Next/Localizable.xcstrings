    "Accueil" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home"
          }
        }
      }
    },
    "Accueil : prochain trajet, favoris, lieux favoris, départs et carte. Itinéraire : aller d'un point à un autre. Trajets : vos itinéraires enregistrés et trajets réguliers. La loupe (Explorer) : chercher un arrêt, un lieu ou une ligne." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start: nächste Fahrt, Favoriten, Lieblingsorte, Abfahrten und Karte. Verbindung: von einem Ort zum anderen. Fahrten: Ihre gespeicherten Verbindungen und regelmässigen Fahrten. Die Lupe (Entdecken): eine Haltestelle, einen Ort oder eine Linie suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: next trip, favorites, favorite places, departures and map. Route: get from one place to another. Trips: your saved routes and regular trips. The magnifying glass (Explore): find a stop, a place or a line."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: next trip, favourites, favourite places, departures and map. Route: get from one place to another. Trips: your saved routes and regular trips. The magnifying glass (Explore): find a stop, a place or a line."
          }
        }
      }
    },
    "Accueil repensé" : {
      "localizations" : {
