    "« Arrêter le suivi » depuis le trajet ; le suivi se termine aussi de lui-même à l'arrivée." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Verfolgung beenden“ in der Fahrt; die Verfolgung endet bei der Ankunft auch von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Stop Tracking” from the trip; tracking also ends on its own on arrival."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Stop Tracking’ from the trip; tracking also ends on its own on arrival."
          }
        }
      }
    },
    "« Suivre en direct » depuis un itinéraire, le prochain trajet de l'accueil, un itinéraire enregistré ou un départ (appui long, « Suivre en direct », puis l'autre arrêt)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Live verfolgen“ in einer Verbindung, der nächsten Fahrt auf der Startseite, einer gespeicherten Verbindung oder einer Abfahrt (lange drücken, „Live verfolgen“, dann die andere Haltestelle)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Track Live” from a route, the next trip on Home, a saved route or a departure (long press, “Track Live”, then the other stop)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Track Live’ from a route, the next trip on Home, a saved route or a departure (long press, ‘Track Live’, then the other stop)."
          }
        }
      }
    },
