            "state" : "translated",
            "value" : "Details"
          }
        }
      }
    },
    "Le meilleur itinéraire du moment est proposé, quelles que soient les lignes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zu diesem Zeitpunkt beste Verbindung wird vorgeschlagen, unabhängig von den Linien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best route at the time is suggested, whatever the lines."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best route at the time is suggested, whatever the lines."
          }
        }
      }
    },
    "Le menu « … »" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
