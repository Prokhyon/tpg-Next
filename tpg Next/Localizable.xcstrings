    "Actions de l'itinéraire" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktionen für die Verbindung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route actions"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route actions"
          }
        }
      }
    },
    "Activé, l'app retrouve chaque jour vos lignes et vous prévient si elles ne sont pas proposées, avec une alternative. Désactivé, elle propose le meilleur itinéraire du moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, sucht die App jeden Tag Ihre Linien und meldet sich mit einer Alternative, falls sie nicht angeboten werden. Wenn deaktiviert, schlägt sie die zu diesem Zeitpunkt beste Verbindung vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the app finds your lines every day and lets you know if they aren’t offered, with an alternative. When off, it suggests the best route at the time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the app finds your lines every day and lets you know if they aren’t offered, with an alternative. When off, it suggests the best route at the time."
          }
        }
      }
    },
    "Activer ou couper" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein- oder ausschalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on or off"
          }
