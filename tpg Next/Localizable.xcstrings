    "Le %@ partait au moment où vous descendiez. Êtes-vous monté dedans ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linie %@ fuhr gerade ab, als Sie ausstiegen. Sind Sie eingestiegen?"
          }
        },
        "en" : {
          "stringUnit" : {
