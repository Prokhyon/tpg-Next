    "Quand partir pour votre prochain trajet régulier ou itinéraire enregistré, jusqu'à 36 heures à l'avance. Il existe aussi pour l'écran verrouillé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann Sie für Ihre nächste regelmässige Fahrt oder gespeicherte Verbindung losgehen müssen, bis zu 36 Stunden im Voraus. Auch für den Sperrbildschirm verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When to leave for your next regular trip or saved route, up to 36 hours ahead. It’s also available for the Lock Screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
